# TerraMind AI — backend configuration
#
# Copy to apps/backend/.env and adjust. Every variable below is read by
# src/core/config.py (pydantic-settings). Names must match exactly: unknown keys
# are silently ignored (extra="ignore"), so a typo fails quietly rather than
# loudly.
#
# IMPORTANT: env_file=".env" is resolved relative to the CURRENT WORKING
# DIRECTORY. The backend must be started from apps/backend, otherwise none of
# this is loaded and the defaults in config.py are used instead.

# ─── Required ────────────────────────────────────────────────────────────────

# Async SQLAlchemy URL. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://terramind:terramind_local@localhost:5432/terramind_db

# Redis, used by Celery and the readiness check.
REDIS_URL=redis://localhost:6379/0

# Replace for any non-local environment. Do not commit a real secret.
SECRET_KEY=change-me

# ─── CORS ────────────────────────────────────────────────────────────────────
#
# ALLOWED_ORIGINS is the canonical variable controlling CORS. It is read in
# src/core/config.py and applied by CORSMiddleware in src/main.py.
#
# It is typed list[str], so pydantic-settings parses it as JSON. A
# comma-separated string is REJECTED with a SettingsError — the value must be a
# JSON array, quoted so the shell does not mangle the brackets.
#
# Must contain the exact origin the browser sends, including scheme and port.
# The Vite dev server runs on 5273 (see scripts/start_stack.ps1); note that
# localhost and 127.0.0.1 are distinct origins to the browser.
ALLOWED_ORIGINS='["http://localhost:5273", "http://127.0.0.1:5273"]'

# ─── Gemini API (natural-language spatial queries) ───────────────────────────
#
# Server-side only. This key is never sent to the browser: the frontend calls
# TerraMind, and TerraMind calls Gemini. The model is asked only to interpret
# the question into a validated structure - it receives no feature data and no
# identifiers, and never touches the database.
#
# Leave unset to run without natural-language queries: /query/natural then
# returns 503 and every other endpoint works normally.
# GEMINI_API_KEY=...
#
# KEY ROTATION. Gemini's free tier caps requests per day per project per model,
# so one key stops answering well before the day ends. Configure several and a
# request refused for quota (HTTP 429) is retried on the next key automatically,
# with no restart. Numbering sets the order; gaps are fine, and the numbers are
# what appear in logs ("Gemini key 2 exhausted") - the keys never do.
#
# Keys on the SAME Google Cloud project share one quota, so extra slots only
# add headroom when they come from different projects.
# GEMINI_API_KEY_1=...
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
#
# GEMINI_API_KEY (unnumbered) still works on its own and is used last when both
# forms are set.

# Model used for interpretation.
# NLQ_MODEL=gemini-3.6-flash

# ─── Optional (defaults in config.py are usually fine locally) ───────────────

# ENVIRONMENT=development
# DEBUG=false
# LOG_LEVEL=INFO

# Celery — defaults already point at the local Redis container.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# External geospatial providers (public, no API key required).
# EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
# TITILER_URL=https://titiler.xyz
# PROVIDER_TIMEOUT_SECONDS=15.0
