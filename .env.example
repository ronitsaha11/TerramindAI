# TerraMind AI — root environment
#
# This file configures docker-compose ONLY. Copy to .env at the repository root.
#
# There are three separate environment files in this project:
#
#   .env                  → docker-compose (this file)
#   apps/backend/.env     → FastAPI, see apps/backend/.env.example
#   frontend/.env         → Vite, see frontend/.env.example
#
# CORS is configured by ALLOWED_ORIGINS in apps/backend/.env — NOT here.

# ─── PostgreSQL / PostGIS container ──────────────────────────────────────────
# Consumed by docker-compose.yml. If you change these, update DATABASE_URL in
# apps/backend/.env to match.
POSTGRES_USER=terramind
POSTGRES_PASSWORD=terramind_local
POSTGRES_DB=terramind_db

# The db container publishes 5432 and redis publishes 6379 on the host; both
# ports are fixed in docker-compose.yml and are not configurable here.

# ─── Claude API (natural-language spatial queries) ───────────────────────────
# Passed through to the backend and worker containers by docker-compose. Server
# side only — it is never exposed to the browser. Leave unset to run without
# natural-language queries: /query/natural returns 503, nothing else changes.
# ANTHROPIC_API_KEY=sk-ant-...
