# TerraMind AI — frontend configuration
#
# Copy to frontend/.env. Only variables prefixed with VITE_ are exposed to the
# browser by Vite.

# Base URL of the backend API.
#
# The /api/v1 suffix is REQUIRED. The application appends paths directly to this
# value (e.g. `${VITE_API_BASE_URL}/projects/{id}/datasets`), so omitting the
# suffix produces 404s on every request.
#
# This origin must also appear in ALLOWED_ORIGINS in apps/backend/.env, or the
# browser will block the responses even though the API itself answers correctly.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
